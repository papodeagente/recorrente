# ============================================================================
# RECORRENTE — variáveis de ambiente
# ============================================================================
# Para dev local com OrbStack/Docker Compose:
#   - DATABASE_URL aponta para o serviço `postgres` do compose
#   - REDIS_URL aponta para o serviço `redis` do compose
# Em produção (Coolify), substitua pelas URLs internas dos serviços.

# ---- Postgres ----
DATABASE_URL=postgres://recorrente:recorrente@localhost:5432/recorrente_dev

# ---- Redis (BullMQ + Socket.IO adapter) ----
REDIS_URL=redis://localhost:6379

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Modelos por finalidade (defaults conservadores)
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ---- Z-API (uma instância por tenant é guardada em tenants.zapi_*) ----
# Estes são apenas para chamadas administrativas (cadastro de webhooks etc).
# Cada tenant traz suas próprias credenciais e elas são persistidas.

# ---- Auth ----
# Gere com: openssl rand -base64 32
AUTH_SECRET=changeme-development-secret-please-rotate
SESSION_COOKIE_NAME=recorrente_session

# ---- App ----
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# ---- Runtime ----
# 'web' para o processo Next.js, 'worker' para o processo de workers BullMQ.
# O bootstrap usa essa flag para decidir se conecta filas como produtor ou consumidor.
RUNTIME_ROLE=web
